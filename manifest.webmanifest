{
  "name": "Kassza",
  "short_name": "Kassza",
  "description": "Ingyenes offline költségkövető és borítékos költségvetés.",
  "lang": "hu",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f6b4f",
  "theme_color": "#0f6b4f",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/csv",
            ".csv",
            "text/comma-separated-values",
            "text/plain",
            "application/vnd.ms-excel",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}